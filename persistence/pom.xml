<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rota</groupId>
    <artifactId>rota</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rota-persistence</artifactId>
  <name>rota-persistence</name>
  <description>PostgreSQL persistence (JPA, Spring Data, Flyway) for the application roster port</description>

  <dependencies>
    <dependency>
      <groupId>dev.rota</groupId>
      <artifactId>rota-application</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Plain libraries, no Spring Boot starters: no auto-configuration, so the default profile never
         needs a database (QUESTIONS.md P09 P2). Versions managed by the Spring Boot 4.1.2 parent. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway: versions from VERSIONS.md (P09). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>13.13.0</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>13.13.0</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests: spring-test + JUnit (Boot-managed), Testcontainers core (VERSIONS.md), ArchUnit. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>2.0.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
