<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rota</groupId>
    <artifactId>rota</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rota-bootstrap</artifactId>
  <name>rota-bootstrap</name>
  <description>Spring Boot application: REST API, adapters, wiring (P06)</description>

  <dependencies>
    <dependency>
      <groupId>dev.rota</groupId>
      <artifactId>rota-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Solver adapter (SolverSchedulingAdapter). Timefold arrives transitively; only the solver
         module's own classes are used here. -->
    <dependency>
      <groupId>dev.rota</groupId>
      <artifactId>rota-solver</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- PostgreSQL adapter (P09); its configuration is active only under Spring profile "postgres". -->
    <dependency>
      <groupId>dev.rota</groupId>
      <artifactId>rota-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spring MVC + embedded server + JSON. Boot 4 starter name; version from the Boot parent.
         UNVERIFIED (QUESTIONS.md P06 J2): fallback is spring-boot-starter-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- JUnit, spring-test (MockMvc), json-path, Hamcrest; version from the Boot parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PostgresProfileApiTest: real PostgreSQL in Docker. Version from VERSIONS.md. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>2.0.5</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
