# Copy this file to .env in the repo root and change the password. Never commit .env
# (it is gitignored). Read by scripts/dev-up.ps1 / dev-down.ps1 (docker compose --env-file)
# and scripts/run-api-postgres.ps1 (API with Spring profile "postgres").
POSTGRES_DB=rota
POSTGRES_USER=rota
POSTGRES_PASSWORD=change-me
